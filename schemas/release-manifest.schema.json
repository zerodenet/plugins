{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugins.zerodenet.org/schemas/release-manifest.schema.json",
  "title": "ZeroDeNet publisher release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "repository", "publisher", "source", "release"],
  "properties": {
    "schema_version": { "const": 1 },
    "product_id": { "$ref": "#/$defs/id" },
    "repository": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "publisher": { "$ref": "#/$defs/publisher" },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["tag", "commit"],
      "properties": { "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" } }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "channel", "published_at", "notes_url", "targets"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "channel": { "enum": ["stable", "rc", "dev"] },
        "published_at": { "type": "string", "format": "date-time" },
        "notes_url": { "type": "string", "format": "uri" },
        "targets": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/target" } }
      }
    },
    "listing": { "$ref": "product-registry.schema.json#/$defs/product" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,159}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "publisher": {
      "type": "object", "additionalProperties": false, "required": ["id", "public_key"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "public_key": { "type": "string", "minLength": 44, "maxLength": 44 } }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "arch", "url", "size", "sha256", "signature"],
      "properties": {
        "os": { "enum": ["any", "linux", "darwin", "windows", "android", "ios"] },
        "arch": { "enum": ["any", "amd64", "arm64"] },
        "url": { "type": "string", "format": "uri" },
        "size": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "signature": {
          "type": "object", "additionalProperties": false, "required": ["algorithm", "value"],
          "properties": { "algorithm": { "const": "ed25519" }, "value": { "type": "string", "minLength": 1, "maxLength": 256 } }
        }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "package_id", "host_version", "surfaces", "capabilities", "artifacts"],
      "properties": {
        "host": { "enum": ["zboard", "znet-sink"] },
        "package_id": { "$ref": "#/$defs/id" },
        "host_version": {
          "type": "object", "additionalProperties": false, "required": ["min"],
          "properties": { "min": { "$ref": "#/$defs/version" }, "max_exclusive": { "$ref": "#/$defs/version" } }
        },
        "surfaces": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 80 } },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "artifacts": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/artifact" } }
      }
    }
  }
}
