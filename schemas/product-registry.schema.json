{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugins.zerodenet.org/schemas/product-registry.schema.json",
  "title": "ZeroDeNet marketplace product registry v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "products"],
  "properties": {
    "schema_version": { "const": 3 },
    "products": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/product" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,159}$" },
    "publisher": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "public_key"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "public_key": { "type": "string", "minLength": 44, "maxLength": 44 } }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "package_id", "surfaces", "capabilities"],
      "properties": {
        "host": { "enum": ["zboard", "znet-sink"] },
        "package_id": { "$ref": "#/$defs/id" },
        "surfaces": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 80 } },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "description", "categories", "license", "maintainers", "repository", "publisher", "release_source", "targets"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "categories": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "license": { "type": "string", "minLength": 1, "maxLength": 160 },
        "maintainers": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "repository": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "publisher": { "$ref": "#/$defs/publisher" },
        "release_source": {
          "type": "object", "additionalProperties": false, "required": ["type", "metadata_asset"],
          "properties": { "type": { "const": "github-releases" }, "metadata_asset": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.json$" } }
        },
        "targets": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/target" } },
        "homepage": { "type": "string", "format": "uri" },
        "documentation": { "type": "string", "format": "uri" },
        "security": { "type": "string", "format": "uri" },
        "icon": { "type": "string", "format": "uri" },
        "screenshots": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
        "withdrawn": { "const": true }
      }
    }
  }
}
