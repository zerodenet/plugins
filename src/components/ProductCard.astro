---
import { latest, type Product } from '../lib/marketplace';
import { hostDescription } from '../lib/host-contracts';
const { product } = Astro.props as { product: Product };
const hosts = product.targets.map((target) => target.host);
const installable = product.targets.some((target) => Boolean(latest(target)?.artifacts.length));
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const detailUrl = `${base}plugins/${product.id}/`;
---
<article class="product-card" data-market-card data-search={`${product.id} ${product.name} ${product.description} ${product.publisher.id}`.toLowerCase()} data-hosts={hosts.join(',')} data-categories={product.categories.join(',')}>
  <div class="card-head">
    {product.icon ? <img src={product.icon} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <span class="monogram">{product.name.slice(0, 1)}</span>}
    <div class="host-badges">{hosts.map((host) => <span title={host}>{hostDescription(host) || host}</span>)}</div>
  </div>
  <div>{product.categories.length > 0 && <p class="eyebrow">{product.categories.join(' · ')}</p>}<h2><a href={detailUrl}>{product.name}</a></h2><p>{product.description}</p></div>
  <div class="card-meta"><span>发布者 {product.publisher.id}</span><span class:list={["availability", { ready: installable }]}>{installable ? '已有可验证产物' : '源码已登记'}</span></div>
  <a class="card-link" href={detailUrl}>查看详情 <span aria-hidden="true">→</span></a>
</article>
