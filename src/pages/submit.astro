---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="提交插件 · ZeroDeNet 插件市场" description="准备并提交 ZeroDeNet 插件市场首次入驻申请。">
  <section class="document-page wide-page">
    <a class="back" href={`${base}developers/`}>← 先了解发布流程</a>
    <p class="eyebrow">插件入驻</p>
    <h1>提交你的插件。</h1>
    <p class="lead">一个产品只需首次登记一次。请先发布正式签名版本和固定的 <code>marketplace-entry.json</code>，站内表单会整理申请内容，最后由你在 GitHub 登录并确认提交。</p>
    <div class="notice"><strong>更新已登记资料</strong><p>名称、简介、分类、链接或其他登记字段需要修改时，请使用 <a class="text-link" href="https://github.com/zerodenet/plugins/issues/new?template=update-plugin.yml">资料更新模板</a>。Action 只会从固定发行清单原样复制字段并生成审核 PR。</p></div>
    <div class="notice"><strong>提交前请确认</strong><p>不要填写源码、安装包、访问令牌或签名私钥。单宿主插件只选择实际支持的宿主；扩大能力或更换发布者公钥需要重新审核。</p></div>

    <form class="submission-form" data-submission-form>
      <fieldset>
        <legend>基本信息</legend>
        <label><span>产品 ID</span><input name="product" required pattern="[a-z0-9]+(?:[._-][a-z0-9]+)+" placeholder="org.example.product" /><small>稳定且不可静默更换，例如 org.example.product</small></label>
        <label><span>源码仓库</span><input name="repository" required type="url" placeholder="https://github.com/owner/plugin" /></label>
        <label><span>入驻发行与源码提交</span><input name="release" required placeholder="v1.0.0 · 完整 commit SHA" /></label>
        <label><span>固定发行元数据链接</span><input name="metadata" required type="url" pattern="https://github\.com/.+/releases/download/v[^/]+/marketplace-entry\.json" placeholder="https://github.com/owner/plugin/releases/download/v1.0.0/marketplace-entry.json" /><small>必须来自正式 GitHub Release，并且申请中只能出现这一条元数据链接。</small></label>
      </fieldset>

      <fieldset>
        <legend>支持范围</legend>
        <div class="field-group"><span>宿主目标</span><div class="check-row"><label><input type="checkbox" name="host" value="ZBoard" /> ZBoard</label><label><input type="checkbox" name="host" value="ZNet Sink" /> ZNet Sink</label></div><small data-host-error>至少选择一个真实支持的宿主。</small></div>
        <label><span>发布者身份与公钥</span><textarea name="publisher" required rows="4" placeholder="公钥 ID、Base64 Ed25519 公钥、可独立核实归属的渠道。请勿填写私钥。"></textarea></label>
        <label><span>能力、界面与数据边界</span><textarea name="compatibility" required rows="5" placeholder="列出每个宿主允许使用的最大能力和页面范围，以及迁移、数据保留与卸载行为。"></textarea></label>
        <label><span>验证与维护证据</span><textarea name="validation" required rows="5" placeholder="CI 链接、实际宿主与平台测试、许可证、维护者和安全联系渠道。"></textarea></label>
      </fieldset>

      <div class="form-submit"><div><strong>最后一步在 GitHub 完成</strong><p>点击后会打开已整理好的申请；请复核内容并由你的 GitHub 账号正式提交。</p></div><button class="button primary" type="submit">整理并前往 GitHub</button></div>
    </form>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>('[data-submission-form]');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const hosts = data.getAll('host').map(String);
      const hostError = form.querySelector<HTMLElement>('[data-host-error]');
      if (!hosts.length) {
        hostError?.classList.add('error');
        form.querySelector<HTMLInputElement>('input[name="host"]')?.focus();
        return;
      }
      hostError?.classList.remove('error');
      const value = (name: string) => String(data.get(name) || '').trim();
      const body = [
        '## Onboarding metadata / 入驻发行元数据', value('metadata'),
        '## Host targets / 宿主目标', hosts.map((host) => `- [x] ${host}`).join('\n'),
        '## Source repository / 源码仓库', value('repository'),
        '## Onboarding release and source commit / 入驻发行与源码提交', value('release'),
        '## Publisher identity and public key / 发布者身份与公钥', value('publisher'),
        '## Capability ceiling and data / 能力上限与数据', value('compatibility'),
        '## Validation and maintenance / 验证与维护', value('validation'),
      ].join('\n\n');
      const url = new URL('https://github.com/zerodenet/plugins/issues/new');
      url.searchParams.set('title', `[Plugin] ${value('product')}`);
      url.searchParams.set('labels', 'plugin:submission');
      url.searchParams.set('body', body);
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  </script>
</BaseLayout>
